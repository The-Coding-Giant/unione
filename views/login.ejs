<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-box">
    <h1 class="login-title">⚡ RedirectFlow</h1>
    <p class="login-subtitle">Sign in to manage dynamic URL redirects</p>

    <% if (error) { %>
      <div class="alert alert-error" style="margin-top: 0; margin-bottom: 20px;">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label class="form-label" for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          class="input" 
          placeholder="Username" 
          required 
          autofocus
        >
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          class="input" 
          placeholder="Password" 
          required
        >
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: 8px;">
        Sign In
      </button>
    </form>
  </div>
</body>
</html>
